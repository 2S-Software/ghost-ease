{{!< default}}

<div class="gh-outer">
<main class="site-main gh-inner">

    {{!-- CHANGE: Inhalt einer separaten Page unter dem Cover-Bild (Slug anpassen) --}}
    {{#get "pages" slug="home-intro" limit="1" as |intro_page|}}
        {{#intro_page}}
            <section class="home-intro gh-content gh-canvas">
                {{content}}
            </section>
        {{/intro_page}}
    {{/get}}
    {{!-- CHANGE: Inhalt einer separaten Page unter dem Cover-Bild --}}

 {{!-- CHANGE: Neueste Einträge auflisten --}}    
  {{!--
    {{> "latest-posts"}}
   --}}
 {{!-- CHANGE: Neueste Einträge auflisten --}}

    {{#if @custom.show_featured_posts}}
        {{> "featured-posts"}}
    {{/if}}

    {{#get "tags" limit="10"}}
    <div class="topic-feed">

        {{#foreach tags}}
            <section class="topic">
                <header class="topic-header">
                    <h2 class="topic-name">
                        <a href="{{url}}">{{name}}</a>
                    </h2>
                </header>
                {{#get "posts" order="published_at asc" filter="tag:{{slug}}" limit="5" as |featured|}}
                    <ul class="topic-article-feed">
                        {{#foreach featured}}
                        <li class="topic-article">
                            <h3 class="topic-article-title">
                                <a class="topic-article-link" href="{{url}}">
                                    {{> "icons/chevron-right"}} {{title}}
                                </a>
                            </h3>
                        </li>
                        {{/foreach}}
                    </ul>
                {{/get}}
                {{!-- CHANGE: Übersetzung für "Show more" --}}
                <a class="topic-more" href="{{url}}">{{t "Show more"}} →</a>
                {{!-- CHANGE: Übersetzung für "Show more" --}}
            </section>
        {{/foreach}}

    </div>
    {{/get}}


</main>
</div>