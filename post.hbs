{{!< default}}

<main class="site-main">

    {{#post}}

    <article class="{{post_class}}">

        <header class="gh-article-header gh-canvas">
            <h1 class="gh-article-title">{{title}}</h1>


  {{!-- BEGIN CHANGE: Auszug im Post --}}
  <style>
  .post-excerpt {
    font-size: 2rem;
    line-height: 1.5;
    color: #000000;
    
  }
 </style>
 {{#if custom_excerpt}}
  <p class="post-excerpt">{{custom_excerpt}}</p>
{{else}}
  <p class="post-excerpt">{{excerpt words="40"}}</p>
{{/if}}
{{!-- END CHANGE: Auszug im Post --}}
          
            <div class="gh-meta-share">
                <div class="post-meta">
                    <div class="post-meta-updated">
                        {{t "Last updated on"}}&nbsp;
                        <time datetime="{{date format="YYYY-MM-DD"}}">{{date updated_at format="D MMM YYYY"}}</time>
                    </div>
                    {{!-- BEGIN CHANGE: Reading time --}}
                    <div class="post-meta-reading-time">
                        <span class="reading-time">{{reading_time minute="1 Min." minutes="% Min."}}&nbsp;{{t "reading time"}}</span>
                    </div>
                    {{!-- END CHANGE: Reading time --}}
                </div>
  {{!-- BEGIN CHANGE: Share-Button in Akzentfarbe --}}
  <style>
    .gh-button-share {
      border: 1px solid {{@site.accent_color}};
      color: {{@site.accent_color}};
    }
.gh-button-share:hover {
      background-color: {{@site.accent_color}};
  border: 1px solid {{@site.accent_color}};
      color: #ffffff;
    }
  </style>
  {{!-- END CHANGE: Share-Button in Akzentfarbe --}}
                <a href="#/share" class="gh-button-share">{{t "Share"}}</a>
            </div>
            {{> "post-image"}}
        </header>

        <div class="gh-content gh-canvas">
            {{content}}
        </div>

        <div class="pagination-container gh-canvas">
        <nav class="pagination">

            <div class="pagination-left">
                {{#prev_post}}
                    <a class="newer-posts" href="{{url}}">
                        <span class="pagination-label">Previous</span>
                        {{title}}
                    </a>
                {{/prev_post}}
            </div>

            <div class="pagination-right">
                {{#next_post}}
                    <a class="older-posts" href="{{url}}">
                        <span class="pagination-label">Next</span>
                        {{title}}
                    </a>
                {{/next_post}}
            </div>

        </nav>
        </div>

        {{#if comments}}
            <div class="gh-comments gh-canvas">
                {{comments}}
            </div>
        {{/if}}

    </article>

    {{/post}}

</main>